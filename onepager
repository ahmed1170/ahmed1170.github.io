(()=>{const portraitData='data:image/jpeg;base64,';const body=document.body,theme=document.getElementById('theme');let saved;try{saved=localStorage.getItem('ahmed-theme')}catch(e){}function setTheme(dark){body.classList.toggle('dark',dark);theme.setAttribute('aria-pressed',String(dark));theme.querySelector('span').textContent=dark?'Light Mode':'Dark Mode'}setTheme(saved==='dark');theme.addEventListener('click',()=>{const dark=!body.classList.contains('dark');setTheme(dark);try{localStorage.setItem('ahmed-theme',dark?'dark':'light')}catch(e){}});document.getElementById('year').textContent=new Date().getFullYear();const img=document.getElementById('portrait'),placeholder=document.getElementById('placeholder'),title=document.getElementById('placeholder-title'),hint=document.getElementById('placeholder-text'),buttons=[...document.querySelectorAll('[data-image]')],upload=document.getElementById('upload');let objectUrl;function show(src,label,sheet){img.style.display='none';placeholder.style.display='block';title.textContent='Platz für '+label;hint.textContent='Bild hinzufügen und direkt ansehen';img.onload=()=>{img.style.display='block';placeholder.style.display='none'};img.onerror=()=>{img.style.display='none';placeholder.style.display='block';hint.textContent='Datei nicht gefunden – Vorschau unten auswählen'};img.alt=label+' von Ahmed Izzat';img.classList.toggle('sheet',sheet);img.src=src}buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));show(button.dataset.image==='portrait.jpg'?portraitData:button.dataset.image,button.dataset.label,button.dataset.image==='charactersheet.png')}));upload.addEventListener('change',()=>{if(!upload.files.length)return;if(objectUrl)URL.revokeObjectURL(objectUrl);objectUrl=URL.createObjectURL(upload.files[0]);const active=buttons.find(b=>b.getAttribute('aria-pressed')==='true');show(objectUrl,active.dataset.label,active.dataset.image==='charactersheet.png')});s